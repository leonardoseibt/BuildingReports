# Copy this file to .env and fill the values
# Database (Neon/Postgres)
DATABASE_URL=postgres://USER:PASSWORD@HOST:PORT/DBNAME

# Express / App
PORT=5000
SESSION_SECRET=dev-super-secret-change-me

# Replit OIDC (production). For local dev these can be omitted to use dev auth.
REPL_ID=
REPLIT_DOMAINS=
ISSUER_URL=https://replit.com/oidc
